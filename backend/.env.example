# ─────────────────────────────────────────────────────────────
#  backend/.env.example
#  Copy this file to backend/.env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Pinata JWT token
# Get yours at: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# Blockchain RPC URL (local Hardhat node)
RPC_URL=http://127.0.0.1:8545

# Deployed smart contract address
# Run: npx hardhat run scripts/deploy.js --network localhost
CONTRACT_ADDRESS=

# Private key of the wallet used to sign transactions
# Copy from the 'npx hardhat node' output (test wallets only!)
PRIVATE_KEY=

# PostgreSQL connection string
# Create the DB first: createdb docverifier
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docverifier
